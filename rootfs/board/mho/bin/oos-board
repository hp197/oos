#!/bin/sh
# Copyright (C) 2026 dekajoule
# SPDX-License-Identifier: GPL-2.0-or-later
# What rcS asks of the board, the MHO900 here (docs/mho.md): a port of the platform. rcS takes the demo signal; touch,
# screen and network are the board's. The acquisition board starts from the unit's own snapshot when its owner copied
# one to /oos (oos-mho-live, after oos-ui runs); a file /oos/mho-manual leaves that to the owner.
#
#   oos-board has-hardware       exit 1: rcS starts no acquisition hardware (oos-mho-live does, in the background)
#   oos-board early STATUS       gives the CPU's thermal zone the step_wise governor, which drives the fan from the
#                                zone's active trips (the device tree); mounts /rigol read only (oos-mount-rigol), so
#                                vendor.bin gives the model and the MAC; starts oos-mho-live 8 s later when
#                                /oos/mho-snapshot.txt is there
#   oos-board drivers            kernel modules of the board: the touch panel
#   oos-board ui-args STATUS     prints nothing (demo signal)
#   oos-board bring-up STATUS    exit 1: no acquisition hardware comes up
#   oos-board mac                prints the unit's own LAN MAC (vendor.bin, read only), nothing if it cannot be read
case "$1" in
has-hardware) exit 1;;
early)
	for z in /sys/class/thermal/thermal_zone*; do
		[ "$(cat "$z/type" 2>/dev/null)" = cpu-thermal ] && echo step_wise > "$z/policy" 2>/dev/null
	done
	/bin/oos-mount-rigol >/dev/null 2>&1
	if [ -r /oos/mho-snapshot.txt ] && [ ! -e /oos/mho-manual ]; then
		(setsid sh -c 'sleep 8; /bin/oos-mho-live > /tmp/oos-mho-live.log 2>&1' < /dev/null > /dev/null 2>&1 &)
	fi
	exit 0;;
drivers)
	insmod /lib/modules/$(uname -r)/kernel/drivers/input/touchscreen/edt-ft5x06.ko 2>/dev/null
	exit 0;;
ui-args) exit 0;;
bring-up) exit 1;;
mac) /bin/oos-fpgad model 2>/dev/null | sed -n 's/^mac  *//p';;
*) echo "usage: oos-board has-hardware | early STATUS | drivers | ui-args STATUS | bring-up STATUS | mac" >&2; exit 2;;
esac
